      "parameters": {
        "jsCode": "let prevAttempt = 0;\n\ntry {\n  const w = $('Retry Wait').first();\n\n  if (\n    w &&\n    w.json &&\n    typeof w.json.attempt === 'number'\n  ) {\n    prevAttempt = w.json.attempt;\n  }\n} catch (e) {}\n\nconst rawStatus =\n  $json?.statusCode ??\n  $json?.status ??\n  $json?.error?.statusCode ??\n  $json?.error?.status;\n\nconst parsedStatus = Number(rawStatus);\n\nconst status = Number.isFinite(parsedStatus)\n  ? parsedStatus\n  : null;\n\nconst msg = [\n  $json?.error?.message,\n  $json?.error?.description,\n  $json?.error?.code,\n  $json?.message,\n  $json?.error_description,\n  JSON.stringify($json?.error ?? {}),\n]\n  .filter(Boolean)\n  .join(' ')\n  .toLowerCase();\n\nlet outcome = 'FAIL';\nlet transient = false;\n\n// Normal HTTP response\nif (status !== null) {\n\n  // 2xx = success\n  if (status >= 200 && status < 300) {\n    outcome = 'SUCCESS';\n  }\n\n  // 429 / 5xx = retryable\n  else if (status === 429 || status >= 500) {\n    transient = true;\n    outcome = 'RETRY';\n  }\n\n  // any other HTTP status = fail fast\n  else {\n    outcome = 'FAIL';\n  }\n\n} else {\n\n  // Transport/network failures\n  const TRANSPORT_TRANSIENT =\n    /timeout|timed out|etimedout|econnreset|econnrefused|econnaborted|network|socket|enotfound|eai_again|connect timeout|aborted/i;\n\n  if (TRANSPORT_TRANSIENT.test(msg)) {\n    transient = true;\n    outcome = 'RETRY';\n  } else {\n    outcome = 'FAIL';\n  }\n}\n\n// Count only failed/retry attempts\nconst attempt = outcome === 'SUCCESS'\n  ? prevAttempt\n  : prevAttempt + 1;\n\nconst exhausted =\n  outcome === 'RETRY' && attempt >= 3;\n\nif (exhausted) {\n  outcome = 'FAIL';\n}\n\nconst delayMs =\n  attempt <= 1 ? 2000 : 5000;\n\nreturn [{\n  json: {\n    method:\n      $json?.method ??\n      $('Execute Workflow Trigger').first().json.method,\n\n    url:\n      $json?.url ??\n      $('Execute Workflow Trigger').first().json.url,\n\n    body:\n      $json?.body ??\n      $('Execute Workflow Trigger').first().json.body ??\n      null,\n\n    outcome,\n    attempt,\n    delayMs,\n    exhausted,\n    transient,\n    status,\n\n    response:\n      $json?.body ??\n      $json,\n\n    message: [\n      $json?.error?.message,\n      $json?.error?.description,\n      $json?.error?.code,\n      $json?.message,\n      $json?.error_description,\n    ]\n      .filter(Boolean)\n      .join(' ')\n  }\n}];"
      },
